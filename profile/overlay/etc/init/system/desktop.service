[Unit]
Description=PureC OS desktop (live session)
Requires=videod.service
After=videod.service

[Service]
ExecStart=/usr/bin/desktop-rs
WorkingDirectory=/root
Environment=HOME=/root
Environment=SHELL=/bin/sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=TERM=xterm-256color
Environment=XDG_SESSION_TYPE=videod
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
